# miniCRM REST API (Basic auth: username = SystemId, password = API key)
# MINICRM_USE_MOCK=true — fixture JSON-ek (minicrm-mcp-server/fixtures/), nincs hálózat
MINICRM_USE_MOCK=false
MINICRM_SYSTEM_ID=
MINICRM_API_KEY=
MINICRM_BASE_URL=https://r3.minicrm.hu
# Éles mód: kérések/perc (hatókör: 60)
MINICRM_RATE_LIMIT_PER_MINUTE=60
# Phase 2 — párhuzamos HTTPS kapcsolatok felső határa (élő)
MINICRM_MAX_CONCURRENT=4
# Phase 2 — HTTP 429 utáni újrapróbálkozások száma (élő)
MINICRM_MAX_429_RETRIES=3
# Phase 2 — válasz törzs rövidített napló stderr-en (1/true)
MINICRM_DEBUG_HTTP=false
# Eszköz-hívás napló: élő módban bekapcsolt; mockhoz állítsd 1-re, kikapcsolás: 0
# MINICRM_LOG_TOOLS=
